# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
release/

# Gradle files
.gradle/
build/
# Kotlin compiler session data, recreated on every build
.kotlin/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ / Android Studio
# The whole directory is ignored on purpose: it holds machine-local paths (SDK locations,
# the emulator selected in deploymentTargetSelector.xml) that break on every other machine.
*.iml
.idea/

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild
.cxx/

# Google Services (e.g. APIs or Firebase)
# google-services.json

# Freeline
freeline.py
freeline/
freeline_project_description.json

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
fastlane/readme.md

# Version control
vcs.xml

# lint
lint/intermediates/
lint/generated/
lint/outputs/
lint/tmp/
lint-results*.html
lint-results*.xml
*.sarif

# Android Profiling
*.hprof

# Keystore files - NEVER commit signing keys
*.jks
*.keystore

# macOS
.DS_Store
.AppleDouble
.LSOverride
__MACOSX/
._*

# Backup files
*~
*.swp
*.bak

# KSP (Kotlin Symbol Processing)
.ksp/

# Secrets and API keys
secrets.properties
api_keys.properties

# Signed release output from the "Generate Signed APK" wizard
/app/release/
/wear/release/

# Local SDK path and, in this project, the keystore path and its passwords —
# local.properties must never be committed.
